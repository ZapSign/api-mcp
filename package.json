{
  "name": "mcp-server-zapsign",
  "version": "2.1.0",
  "description": "Official ZapSign MCP server — remote OAuth (Cloudflare Workers) and local STDIO via npx",
  "private": false,
  "type": "module",
  "main": "dist/stdio/main.js",
  "bin": {
    "mcp-server-zapsign": "dist/stdio/main.js"
  },
  "files": [
    "dist/stdio/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/stdio/main.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:stdio": "tsup src/stdio/main.ts --format esm --target node20 --outDir dist/stdio --clean --sourcemap",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build:stdio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "marketing:snapshot": "node scripts/marketing/take-snapshot.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "agents": "0.20.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.20",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/runner": "^3.2.4",
    "@vitest/snapshot": "^3.2.4",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4",
    "wrangler": "4.71.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "ZapSign",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zapsign",
    "api",
    "electronic-signature",
    "documents",
    "esignature",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZapSign/api-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ZapSign/api-mcp/issues"
  },
  "homepage": "https://github.com/ZapSign/api-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
