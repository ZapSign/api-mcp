# Opt-in ZapSign sandbox integration tests only.
# Copy to test/.env.test only after the owned sandbox account and test inbox are available.
# `npm test` never loads this file; use `npm run test:integration` explicitly.
ZAPSIGN_API_URL=https://sandbox.api.zapsign.com.br
ZAPSIGN_API_TOKEN=
ZAPSIGN_TEMPLATE_TOKEN=
ZAPSIGN_TEST_SIGNER_EMAIL=
ZAPSIGN_TEST_PDF_URL=
ZAPSIGN_ENABLE_NOTIFICATIONS=false
